{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "contractors-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Serve the Vite frontend as static SPA assets.
  // Route API requests through the Worker before applying SPA fallbacks.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  // Run the Go HTTP server in a Cloudflare Container.
  "containers": [
    {
      "class_name": "Backend",
      "image": "../backend/Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }]
}
